 "poems": [
  {
   "seq": "1",
   "text": "萩原やすゑはの露もしらせけりうき身ひとつの秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さやかにもしらぬ計の秋風にうらめつらしき袖の白露",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "今朝みれは野原のくさの露そをく袖より外も秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "里わかす秋はきにけり白露の萩のうは葉に月や澄らん",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "ふか艸のあれにし里をけふみれは野原の露に秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "秋とみしきのふの暮のいかならんあさけの袖の萩か花すり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "宮城野やはつ花摺の秋の色にいつしかうつる心なりけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "風のみかいつしか萩のうへに又秋しりかほにをける白つゆ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "昨日けふまた秋淺き萩のはにいつしか露のやとり馴たる",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "秋きぬとまた夕風も音せぬにあやしや袖に露そ〓ととふ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "みそきせしゐくしに秋や立ぬらんかへれは深し道芝の露",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "昨日みし野への夏艸いつのまにもとあらの萩にをしか鳴らん",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みやきのゝ野へのけしきの色に出て小萩かはらに秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "秋とたにまた大かたはしら露の萩のはならす程もへりにけ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "宮城野や千種の秋の唐にしきかはらぬ露も色そかはれる",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "染わたす萩の錦の花さかりたゝまくおしき野への色かな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "つなかぬ駒も心せよ野への小萩の花さかりなり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "秋きぬとけさはいはれの野へとてや尾花か末に風そほのめく",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "萩が花咲らんをのゝ朝露にぬるゝはかりの袖の色哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "宮城のゝ露をたひねにかたしけは袂にうつる萩か花すり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "艸葉にはあたにおもひし夕露を衣手ならす秋の山風",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "夕つくよくものはたても跡たえて嵐吹なり天のかくやま",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "夕つくひ入さの山の秋風に袂すゝしき日くらしの聲",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "けふも又入相の鐘にかよひきて初瀨のひはら風すさむ也",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "詠めわひぬ秋風今はたつ田山夕ゐる雲もかつ時雨つゝ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "袖の露も泪もいかにしくるらん秋は夕の山おろしのかせ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "猶ふかき夕は空や寒からむ外山のまさ木あき風そ吹",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "いつしかとかはるか秋の夕ま暮すゝみに來つゝなれし山かせ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "村時雨もる山陰の夕かせにもろき木葉の色そうつろふ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "つま木こる片山陰の夕すゝみ袖に吹まく荻のうはかせ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "さやけさも誰か又みん村しくれはれぬる雲の跡の月影",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "村雨のはれ行すゑの雲間より出るも澄る秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "誰里のあさちに露のこほるらん村雨すきぬ月の行ゑに",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "なかめすや一村すくる夕立のはれのゝ跡の山端の月",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "村雨の雲も殘らぬ山のはに待いつる月の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "雨雲のよそに晴ゆく夜半の月さしのほる影の氷る玉水",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "村雨は通りにけりな淺茅生の露にわりなく月をやとして",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "夕暮は雲もとまらす村雨の空とも見えす澄る月かな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "秋の雨の宵の村くも跡きえてはらふ嵐に殘る月かな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "時雨つる雲ふく風をたよりにて千里にすめる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "いのちやはあたの大野の草枕はかなき夢もおしからぬ身を",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "月影にちきりて出し面かけを忘れすしのふ古さとのそら",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "ぬるゝをは山ちの露に〓とよせてかこつ方なき袖の色哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "旅の空いつまれなれし夕暮にわきても物を思ふなるらん",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "春とにかはらす歸る雁かねは霞のうちに道やしるらむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "立わたる霞の末の山端のはつかにみえて歸るかりかね",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "此ころは秋をしのたの杜にきて月の露ちるそての面影",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
